// Place your settings in the file "Packages/User/ProComment.sublime-settings",
// which overrides the settings in here.
{
	// Integer.  Character Set ID
	// --------------------------
	// One of the values from this enumeration class:
	//
	// class CharacterSetID(IntEnum):
	//     UNICODE_SQUARE_CORNERS = 0
	//     UNICODE_ROUND_CORNERS  = 1
	//     UNICODE_2_DASHES       = 2
	//     UNICODE_3_DASHES       = 3
	//     UNICODE_4_DASHES       = 4
	//     UNICODE_SHADOW         = 5
	//     ASCII                  = 6
	"default_character_set_id": 6,

	// Integer.  Fill Brush ID selected at startup.
	// -------------------------------------------
	// One of the values from this enumeration class:
	//
	// class FillBrushID(IntEnum):
	//     NONE         = 0    (no brush:  ordinary line-drawing mode)
	//     LIGHT_SHADE  = 1    ░
	//     MEDIUM_SHADE = 2    ▒
	//     DARK_SHADE   = 3    ▓
	//     FULL_BLOCK   = 4    █
	//     UPPER_HALF   = 5    ▀
	//     LOWER_HALF   = 6    ▄
	//     LEFT_HALF    = 7    ▌
	//     RIGHT_HALF   = 8    ▐
	//
	// The ID is deliberately the same as the digit the brush is bound to,
	// i.e. [Ctrl-Alt-3] selects brush 3.
	//
	// The selected brush is global (remembered within the loaded Package)
	// and applies to all Views at the same time, exactly like the character
	// set.  It is not written back to this file when it changes;  it
	// returns to the value below at the start of each Sublime Text session.
	"default_fill_brush_id": 0,

	// List of 8 single-character strings.
	// -----------------------------------
	// Overrides the fill brushes bound to [Ctrl-Alt-1] through
	// [Ctrl-Alt-8], in that order.  A list that is not exactly 8 entries
	// long, or that contains an entry that is not exactly one character,
	// is reported in the Console and ignored in favor of the built-in
	// brushes below.
	"fill_brush_characters": ["░", "▒", "▓", "█", "▀", "▄", "▌", "▐"],

	// Integer.  Safety limit on flood fill.
	// -------------------------------------
	// Flood fill spreads through real space characters only;  line ends
	// and the edges of the document stop it, so a region is always finite.
	// A region larger than this is abandoned entirely, with a status
	// message, and the Buffer is left untouched.
	"max_flood_cells": 100000,

	// String | Integer | Boolean
	//
	// Selectively turn on and off parts of debugging output in Console Panel.
	//
	// Valid values:
	// - JSON Boolean (true or false, implying "DebugBits.ALL" and "DebugBits.NONE" respectively)
	// - JSON Integer (containing necessary bits, e.g. 32 representing "DebugBits.COMMANDS")
	// - String expressions of bit-wise OR-ed constants from the DebugBits class.
	//   (See below.)
	//
	// class DebugBits:
	//     DEBUGGING              = 0x0001
	//     LOAD_UNLOAD            = 0x0002
	//     SETTINGS_CHANGED_EVENT = 0x0004
	//     QUERY_CONTEXT_EVENT    = 0x0008
	//     ON_OFF_STATE           = 0x0010
	//     COMMANDS               = 0x0020
	//     BOX_DRAWING            = 0x0040
	//     CHARACTER_SET          = 0x0080
	//     FILL_BRUSH             = 0x0100
	//     IMPORTING              = 0x8000
	//
	//     NONE                   = 0x0000
	//     ALL                    = 0xFFFF
	//     ANY                    = 0xFFFF
	//
	// Examples of valid strings:
	// - "DebugBits.NONE"
	// - "DebugBits.LOAD_UNLOAD"
	// - "DebugBits.ALL"
	// - "DebugBits.QUERY_CONTEXT_EVENT | DebugBits.COMMANDS | DebugBits.BOX_DRAWING"
	// - "DebugBits.BOX_DRAWING | DebugBits.ON_OFF_STATE"
	//
	// Note:  the spaces surrounding the '|' operator are optional,
	//        but are recommended for readability.
	"debugging": false,
}
