	// --------------------------------------------------------------------
	// Flood Fill
	//
	// Gated on "box_drawing.ok_to_draw", NOT "box_drawing.ok_to_paint":
	// with no brush selected this command clears a filled region back to
	// spaces, so it has to be reachable in line-drawing mode too.
	// --------------------------------------------------------------------
	{
		"keys": ["alt+shift+space"],
		"command": "box_drawing_flood_fill",
		"context": [
			{ "key": "box_drawing.ok_to_draw", "match_all": true },
		]
	},
]
