	// --------------------------------------------------------------------
	// Box-Drawing ON / OFF
	// --------------------------------------------------------------------
	{
		"keys": ["option+keypad_divide"],
		"command": "box_drawing_toggle_drawing",
	},
	{
		"keys": ["alt+keypad_multiply"],
		"command": "box_drawing_change_character_set",
	},

