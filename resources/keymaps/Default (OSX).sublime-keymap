		"command": "box_drawing_draw_one_character",
		"args": {
			"line_count": 1,
			"direction": 0,
		},
		"context": [
			{ "key": "box_drawing.ok_to_draw", "match_all": true },
		]
	},
	{
		"keys": ["option+shift+up"],
		"command": "box_drawing_draw_one_character",
		"args": {
			"line_count": 2,
			"direction": 0,
