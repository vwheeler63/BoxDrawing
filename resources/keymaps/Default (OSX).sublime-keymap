	// --------------------------------------------------------------------
	// Fill Brushes
	//
	// Gated on "box_drawing.is_on" rather than "box_drawing.ok_to_draw":
	// selecting a brush edits nothing, so it need not care whether there
	// is a selection.  When box drawing is OFF these bindings are not
	// consumed by this Package at all, which matters because [Ctrl-Alt]
	// is [AltGr] on many keyboard layouts.
	// --------------------------------------------------------------------
	// no brush (return to line drawing)
	{
		"keys": ["ctrl+alt+0"],
		"command": "box_drawing_select_fill_brush",
		"args": {
			"brush_id": 0,
		},
		"context": [
			{ "key": "box_drawing.is_on", "match_all": true },
		]
	},
	// ░ Light Shade
	{
		"keys": ["ctrl+alt+1"],
		"command": "box_drawing_select_fill_brush",
		"args": {
			"brush_id": 1,
		},
		"context": [
			{ "key": "box_drawing.is_on", "match_all": true },
		]
	},
	// ▒ Medium Shade
	{
